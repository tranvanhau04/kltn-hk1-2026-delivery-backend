	],
	"item": [
		{
			"name": "1. GET /api/health (Bypass @Public() -> 200 OK)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "2. GET /api/depots (Không có Token -> Chặn 401 Unauthorized)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/depots",
					"host": ["{{baseUrl}}"],
					"path": ["depots"]
				}
			}
		},
		{
			"name": "3. GET /api/depots (Có Token DRIVER -> 200 OK)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token_driver}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/depots",
					"host": ["{{baseUrl}}"],
					"path": ["depots"]
				}
			}
		},
		{
			"name": "4. GET /api/orders/pool (Token DRIVER -> Chặn 403 Forbidden)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token_driver}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/orders/pool",
					"host": ["{{baseUrl}}"],
					"path": ["orders", "pool"]
				}
			}
		},
		{
			"name": "5. GET /api/orders/pool (Token ADMIN -> Cho phép 200 OK)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token_admin}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/orders/pool",
					"host": ["{{baseUrl}}"],
					"path": ["orders", "pool"]
				}
			}
		},
		{
			"name": "6. GET /api/profile (Trích xuất @CurrentUser() -> 200 OK)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token_driver}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/profile",
					"host": ["{{baseUrl}}"],
					"path": ["profile"]
				}
			}
		}
	]
}
